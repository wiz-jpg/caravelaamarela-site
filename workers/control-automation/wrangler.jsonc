{
  "$schema": "https://www.unpkg.com/wrangler@latest/config-schema.json",
  "name": "caravela-control-automation-preview",
  "main": "../../examples/control-cron-worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
